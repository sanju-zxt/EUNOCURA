# EUNOCURA backend - every value has a working default, so this file is optional.
# Copy to .env only when you need to change something.  cp .env.example .env

# --- server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- data
# Absent means the portals have no data; the AI and document paths still work.
# A local mongod is enough: mongodb://localhost:27017
# MONGODB_URI=mongodb://localhost:27017

# --- model
# ollama  local open weights over the OpenAI-compatible API (default)
# gemini  optional cloud fallback (needs GEMINI_API_KEY)
# none    deterministic paths only, no model calls
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_SLM_MODEL=qwen2.5:7b-instruct
OLLAMA_MED_MODEL=medgemma:4b
# GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it

# --- speech (optional; absent means text-only mode, reported by /healthz)
STT_PROVIDER=whisper
WHISPER_MODEL=base

# --- storage (optional; absent means local disk served at /files/<name>)
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# --- auth
# Set a strong random value in any deployment. The dev default is printed as a warning.
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
